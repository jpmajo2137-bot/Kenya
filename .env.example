# ===========================================
# Kenya Vocab App - Environment Variables
# ===========================================
# 이 파일을 복사해서 .env 파일로 만들고, 실제 값을 입력하세요.
#   cp .env.example .env
#
# ⚠️ 보안 정책 (v8.6+)
#   - OpenAI / Gemini 키는 더 이상 클라이언트 (.env) 에 두지 마세요.
#   - 모든 외부 API 키는 Supabase Edge Function 의 secret 으로 설정합니다.
#   - 클라이언트 빌드에 박히는 값은 아래 VITE_* 만입니다.
#   - TTS 는 Supabase Storage 에 사전 업로드된 mp3 만 사용 → 외부 TTS 키 불필요.

# -------------------------------------------
# Firebase (한국어→영어 Oxford 5000)
# 클라이언트 웹 설정 값은 공개되어도 됩니다. 쓰기는 Security Rules 로 차단합니다.
# -------------------------------------------
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# 로컬 에뮬레이터를 쓸 때만 true
# VITE_FIREBASE_USE_EMULATOR=false

# -------------------------------------------
# Supabase (스와힐리어 버전 / 영어→한국어 Oxford)
# -------------------------------------------
# Supabase 프로젝트 URL (https://supabase.com/dashboard)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase anon/public 키 (RLS 적용된 상태에서 노출 OK)
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (선택) 추가 앱 시크릿 - Edge Function 호출 시 X-App-Secret 헤더로 전송
# 클라이언트 번들에 박히기 때문에 100% 안전 X. 비전문 공격자 차단 + abuse 1차 방어용.
# Edge Function 의 APP_SHARED_SECRET 환경변수와 동일한 값 사용.
# VITE_APP_SECRET=

# ===========================================
# 아래는 SERVER 전용 (Edge Function Secrets)
# Supabase Project > Settings > Edge Functions > Manage Secrets
# 또는 CLI: supabase secrets set KEY=VALUE --project-ref <PROJECT_REF>
# ===========================================
#
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-1
#
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# APP_SHARED_SECRET=<위 VITE_APP_SECRET 과 동일한 값>
# ALLOWED_ORIGINS=https://localhost,capacitor://localhost,https://your-pwa.com
#
# (선택, 데이터 생성 스크립트용 - 절대 클라이언트 빌드에 들어가면 안 됨)
# SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
