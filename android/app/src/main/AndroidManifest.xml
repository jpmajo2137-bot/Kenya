<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 구형 Android 기기 지원 (Android 6.0 Marshmallow+) -->
    <uses-sdk tools:overrideLibrary="org.apache.cordova" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        tools:replace="android:usesCleartextTraffic"
        android:allowClearUserData="true"
        android:allowNativeHeapPointerTagging="true"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="false"
        android:preserveLegacyExternalStorage="false"
        tools:targetApi="33">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:theme="@style/AppTheme"
            android:launchMode="singleTask"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        
        <!-- AdMob App ID (필수!) -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-1454258737058608~5622229786"/>
    </application>

    <!-- Permissions (최소 권한 원칙) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- AdMob 광고 ID (Android 13+) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    
    <!--
        과거 방어적으로 차단했던 권한들 (READ/WRITE_EXTERNAL_STORAGE, CAMERA, RECORD_AUDIO,
        ACCESS_FINE/COARSE_LOCATION, READ_PHONE_STATE, READ/WRITE_CONTACTS, GET_ACCOUNTS,
        QUERY_ALL_PACKAGES, SYSTEM_ALERT_WINDOW, REQUEST_INSTALL_PACKAGES, PACKAGE_USAGE_STATS).
        현재 의존성(Capacitor + AdMob + Firebase Analytics + AppUpdate)은 어느 것도 추가하지 않으므로
        tools:node="remove" 항목을 두면 매니페스트 머저가 "no other declaration present" 경고를 낸다.
        새 라이브러리를 추가해 위 권한이 머지된 final manifest 에 다시 들어오면 그때 명시적으로 차단할 것.
    -->

    <!-- Play Store 외부 앱 조회 제한 (Android 11+) -->
    <queries>
        <!-- AdMob 광고 표시에 필요 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- HTTPS 링크 열기 (앱 업데이트 등) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

</manifest>
