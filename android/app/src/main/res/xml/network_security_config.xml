<?xml version="1.0" encoding="utf-8"?>
<!--
  K-Kiswahili-Words Network Security Configuration (RELEASE)
  - 모든 cleartext 트래픽 완전 차단
  - 시스템 신뢰 인증서만 사용 (사용자 추가 CA 거부)
  - debug-overrides 로 개발 환경에서만 cleartext localhost 허용
-->
<network-security-config>
    <!-- 기본: HTTPS 전용, 사용자 추가 CA 거부 (MITM 방지) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 명시적으로 허용된 HTTPS 도메인 (필요한 경우 추가 강제) -->
    <domain-config cleartextTrafficPermitted="false">
        <!-- Supabase -->
        <domain includeSubdomains="true">supabase.co</domain>
        <domain includeSubdomains="true">supabase.com</domain>

        <!-- Google Services -->
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">google.com</domain>
        <domain includeSubdomains="true">gstatic.com</domain>
        <domain includeSubdomains="true">googleadservices.com</domain>
        <domain includeSubdomains="true">doubleclick.net</domain>
        <domain includeSubdomains="true">googlesyndication.com</domain>

        <!-- Firebase -->
        <domain includeSubdomains="true">firebaseio.com</domain>
        <domain includeSubdomains="true">firebase.google.com</domain>
        <domain includeSubdomains="true">firebaseinstallations.googleapis.com</domain>

        <!-- IP 기반 언어 감지 -->
        <domain includeSubdomains="true">ip-api.com</domain>
        <domain includeSubdomains="true">ipapi.co</domain>

        <!-- OpenAI / Microsoft / Gemini -->
        <domain includeSubdomains="true">openai.com</domain>
        <domain includeSubdomains="true">microsoft.com</domain>
        <domain includeSubdomains="true">microsoftonline.com</domain>
        <domain includeSubdomains="true">tts.speech.microsoft.com</domain>

        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- 디버그 빌드에서만 적용 (release APK 에는 포함되지 않음) -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
